<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/background_options"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo_default" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Temas de la Trivia"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@drawable/rounded_black_bg"
                android:padding="6dp" />

            <!-- Checkboxes para los temas -->
            <CheckBox
                android:id="@+id/checkbox_music"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Música"
                android:textColor="@android:color/white"
                android:background="@drawable/rounded_black_bg"
                android:layout_marginBottom="6dp"
                android:padding="4dp" />

            <CheckBox
                android:id="@+id/checkbox_sports"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Deportes"
                android:textColor="@android:color/white"
                android:background="@drawable/rounded_black_bg"
                android:layout_marginBottom="6dp"
                android:padding="4dp" />

            <CheckBox
                android:id="@+id/checkbox_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Historia"
                android:textColor="@android:color/white"
                android:background="@drawable/rounded_black_bg"
                android:layout_marginBottom="6dp"
                android:padding="4dp" />

            <CheckBox
                android:id="@+id/checkbox_generalKnowledge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cultura General"
                android:textColor="@android:color/white"
                android:background="@drawable/rounded_black_bg"
                android:layout_marginBottom="6dp"
                android:padding="4dp" />

            <CheckBox
                android:id="@+id/checkbox_entertainment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Entretenimiento"
                android:textColor="@android:color/white"
                android:background="@drawable/rounded_black_bg"
                android:layout_marginBottom="6dp"
                android:padding="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Número de Preguntas"
                android:textColor="@android:color/white"
                android:background="@drawable/rounded_black_bg"
                android:padding="6dp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_questions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="1.0"
                android:value="5.0"
                android:valueFrom="5.0"
                android:valueTo="10.0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Dificultad"
                android:textColor="@android:color/white"
                android:background="@drawable/rounded_black_bg"
                android:padding="6dp" />

            <Spinner
                android:id="@+id/spinner_difficulty"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_hints"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Pistas"
                android:textColor="@android:color/white"
                android:background="@drawable/rounded_black_bg"
                android:padding="8dp" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>